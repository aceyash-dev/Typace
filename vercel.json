{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/formats",
      "destination": "/api/pages?page=formats"
    },
    {
      "source": "/formats/:slug",
      "destination": "/api/pages?page=formats&slug=:slug"
    },
    {
      "source": "/font/:slug",
      "destination": "/api/pages?page=font&slug=:slug"
    },
    {
      "source": "/faq",
      "destination": "/api/pages?page=faq"
    },
    {
      "source": "/api/fonts/:slug",
      "destination": "/api/font?slug=:slug"
    },
    {
      "source": "/api/css/:slug",
      "destination": "/api/css?slug=:slug"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/browse",
      "destination": "/index.html"
    },
    {
      "source": "/browse/ttf",
      "destination": "/index.html"
    },
    {
      "source": "/browse/otf",
      "destination": "/index.html"
    },
    {
      "source": "/browse/woff2",
      "destination": "/index.html"
    },
    {
      "source": "/browse/woff",
      "destination": "/index.html"
    },
    {
      "source": "/browse/font/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/developers",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/index.html"
    },
    {
      "source": "/security",
      "destination": "/index.html"
    },
    {
      "source": "/api/pages",
      "destination": "/api/pages"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/pages?page=404-json"
    },
    {
      "source": "/(.*)",
      "destination": "/api/pages?page=404"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Accept, Content-Type"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "RateLimit-Limit, RateLimit-Remaining, RateLimit-Reset, Retry-After, X-API-Version, ETag, X-Total-Count"
        },
        {
          "key": "Timing-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/mcp",
      "headers": [
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Accept, Content-Type, MCP-Protocol-Version, Mcp-Session-Id"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "RateLimit-Limit, RateLimit-Remaining, RateLimit-Reset, Retry-After, X-API-Version, X-Request-Id"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        },
        {
          "key": "Timing-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.ttf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/ttf"
        }
      ]
    },
    {
      "source": "/(.*)\\.otf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/otf"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/woff2"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Timing-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/woff"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|png|jpg|jpeg|webp|avif|svg|ico|json|webmanifest))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, immutable"
        }
      ]
    }
  ]
}
